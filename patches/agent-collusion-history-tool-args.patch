+def _history_safe_tool_calls(tool_calls: list[dict[str, Any]]) -> list[dict[str, Any]]:
+    """Copy of tool calls whose arguments are valid JSON, for replay in the message history.
+
+    vLLM json.loads every replayed assistant tool-call argument string; an empty or malformed
+    one (sampled by the policy) makes every later request of the episode fail with HTTP 400.
+    Execution still uses the original arguments; only the replayed copy is repaired.
+    """
+    safe = []
+    for tc in tool_calls:
+        raw = tc.get("function", {}).get("arguments", "{}")
+        if not isinstance(raw, str):
+            safe.append(tc)
+            continue
+        try:
+            json.loads(raw)
+            fixed = raw
+        except ValueError:
+            fixed = "{}" if not raw.strip() else json.dumps({"_unparsed_arguments": raw}, ensure_ascii=False)
+        safe.append({**tc, "function": {**tc["function"], "arguments": fixed}} if fixed is not raw else tc)
+    return safe
+
